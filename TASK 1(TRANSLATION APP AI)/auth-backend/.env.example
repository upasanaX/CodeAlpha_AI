PORT=4000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/translation_app_db

# JWT Secret & Expiry
JWT_SECRET=super_secret_jwt_key_change_in_production_987654321
JWT_EXPIRES_IN=14d

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5000,http://localhost:5000
