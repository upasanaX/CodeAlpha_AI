# =====================================================================
# Google Cloud Translation API v3 Configuration
# =====================================================================

# Absolute or relative path to your Google Cloud Service Account JSON key
GOOGLE_APPLICATION_CREDENTIALS=service_account_key.json

# Your Google Cloud Project ID where Cloud Translation API v3 is enabled
PROJECT_ID=your-google-cloud-project-id

# =====================================================================
# Optional Server Settings
# =====================================================================
PORT=5000
DEBUG=True

# Set to "true" to test the UI and workflow with mock responses
# without needing Google Cloud credentials immediately.
# Set to "false" to use the live Google Cloud Translation API v3.
MOCK_TRANSLATION=false

# =====================================================================
# Optional: Microsoft Translator Text API Configuration
# (Refer to app.py and README.md for instructions to swap providers)
# =====================================================================
# MS_TRANSLATOR_KEY=your_azure_translator_subscription_key
# MS_TRANSLATOR_REGION=your_azure_region
